module

public import SEVerification.SelfSimilarity.Coding

set_option autoImplicit false

/-!
# Finite-Word Transformations

Finite binary words act by composition of the binary contractions.

The initial case distinguishes the first-symbol transformations.
It does not assert injectivity of the map on all finite words.

The noncomputable annotation does not
weaken the theorems or their proofs.

It tells Lean those definitions are mathematical constructions
rather than executable computations.
-/

namespace SEVerification.SelfSimilarity

@[expose] public section

/-- Affine transformation generated by a finite binary word. -/
noncomputable def wordMap : List Bool → ℝ → ℝ
  | [], x => x
  | b :: bs, x => binaryMap b (wordMap bs x)

/-- The two one-symbol words generate different maps. -/
theorem one_symbol_maps_distinct :
    wordMap [true] ≠ wordMap [false] := by
  intro h
  have h0 := congrArg (fun f : ℝ → ℝ => f 0) h
  norm_num [wordMap, binaryMap] at h0

/-- Different maps can send different tail points to one endpoint. -/
theorem boundary_coincidence :
    wordMap [true] 0 = wordMap [false] 1 := by
  norm_num [wordMap, binaryMap]

end

end SEVerification.SelfSimilarity
